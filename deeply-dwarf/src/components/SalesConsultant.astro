---
// SalesConsultant — blue sidebar widget with staff contact list
const staff = [
  { name: 'Ms. Vị',   phone: '0911 650 084' },
  { name: 'Ms. Nhung', phone: '0918 801 771' },
  { name: 'Ms. Vân',  phone: '0914 801 001' },
  { name: 'Ms. Linh', phone: '0918 489 013' },
];
---

<div class="consultant-widget">
  <div class="consultant-widget__header">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
      <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/>
    </svg>
    TƯ VẤN BÁN HÀNG
  </div>
  <ul class="consultant-widget__list">
    {staff.map((person) => (
      <li class="consultant-item">
        <div class="consultant-item__avatar">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        </div>
        <div class="consultant-item__info">
          <span class="consultant-item__name">{person.name}</span>
          <a href={`tel:${person.phone.replace(/\s/g, '')}`} class="consultant-item__phone">{person.phone}</a>
        </div>
        <a href={`tel:${person.phone.replace(/\s/g, '')}`} class="consultant-item__chat" title={`Gọi ${person.name}`} aria-label={`Gọi ${person.name}`}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/>
          </svg>
        </a>
      </li>
    ))}
  </ul>
  <div class="consultant-widget__footer">
    <a href="tel:02873001535" class="consultant-widget__hotline">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
        <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
      </svg>
      Hotline: (028) 7300 1535
    </a>
  </div>
</div>

<style>
  .consultant-widget {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .consultant-widget__header {
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .consultant-widget__list {
    padding: 4px 0;
  }

  .consultant-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-bottom: 1px solid #f0f0f0;
    transition: background 0.15s;
  }

  .consultant-item:last-child {
    border-bottom: none;
  }

  .consultant-item:hover {
    background: #f8f8f8;
  }

  .consultant-item__avatar {
    width: 32px;
    height: 32px;
    background: #e8f1fb;
    color: var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .consultant-item__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .consultant-item__name {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .consultant-item__phone {
    font-size: 0.78rem;
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: none;
  }

  .consultant-item__phone:hover {
    text-decoration: underline;
  }

  .consultant-item__chat {
    width: 28px;
    height: 28px;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 0.15s;
  }

  .consultant-item__chat:hover {
    background: var(--color-primary-dark);
  }

  .consultant-widget__footer {
    border-top: 1px solid var(--color-border);
    padding: 10px 14px;
  }

  .consultant-widget__hotline {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--color-red);
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .consultant-widget__hotline:hover {
    opacity: 0.8;
  }
</style>
