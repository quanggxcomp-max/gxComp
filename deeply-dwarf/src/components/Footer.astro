              <a href="tel:02873001535" class="footer__link footer__link--phone">(028) 7300 1535</a>
            </li>
          </ul>
        </div>

        <!-- Column 2: Thông tin -->
        <div class="footer__col">
          <h3 class="footer__heading">THÔNG TIN</h3>
          <ul class="footer__nav-list">
            <li><a href="/gioi-thieu" class="footer__nav-link">Giới thiệu</a></li>
            <li><a href="/so-do-duong-di" class="footer__nav-link">Sơ đồ đường đi</a></li>
            <li><a href="/lien-he" class="footer__nav-link">Liên hệ</a></li>
            <li><a href="#" class="footer__nav-link">Tuyển dụng</a></li>
            <li><a href="#" class="footer__nav-link">Tin tức - Khuyến mãi</a></li>
          </ul>
        </div>

        <!-- Column 3: Chính sách -->
        <div class="footer__col">
          <h3 class="footer__heading">CHÍNH SÁCH</h3>
          <ul class="footer__nav-list">
            <li><a href="/chinh-sach#chinh-sach-ban-hang" class="footer__nav-link">Chính sách bán hàng</a></li>
            <li><a href="/chinh-sach#chinh-sach-bao-hanh" class="footer__nav-link">Chính sách bảo hành</a></li>
            <li><a href="/chinh-sach#chinh-sach-doi-tra" class="footer__nav-link">Chính sách đổi trả</a></li>
            <li><a href="/chinh-sach#chinh-sach-bao-mat" class="footer__nav-link">Chính sách bảo mật thông tin</a></li>
            <li><a href="#" class="footer__nav-link">Thông tin chuyển khoản</a></li>
            <li><a href="#" class="footer__nav-link">Phương thức vận chuyển</a></li>
          </ul>
        </div>

        <!-- Column 4: Chứng nhận + Social -->
        <div class="footer__col">
          <h3 class="footer__heading">CHỨNG NHẬN</h3>
          <div class="footer__certification">
            <div class="footer__cert-badge">
              <div class="footer__cert-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
              </div>
              <div class="footer__cert-text">
                <span class="footer__cert-line1">ĐÃ THÔNG BÁO</span>
                <span class="footer__cert-line2">BỘ CÔNG THƯƠNG</span>
              </div>
            </div>
          </div>

          <h4 class="footer__subheading">KẾT NỐI VỚI CHÚNG TÔI</h4>
          <div class="footer__social">
            <a href="#" class="footer__social-icon footer__social-icon--facebook" aria-label="Facebook" title="Facebook">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="#" class="footer__social-icon footer__social-icon--twitter" aria-label="Twitter" title="Twitter">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </a>
            <a href="#" class="footer__social-icon footer__social-icon--linkedin" aria-label="LinkedIn" title="LinkedIn">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="#" class="footer__social-icon footer__social-icon--youtube" aria-label="YouTube" title="YouTube">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer__bottom">
    <div class="container">
      <p class="footer__copyright">
        &copy; Copyright 2006 - 2026 by <a href="/" class="footer__copyright-link">gx company</a>. All Rights Reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-footer-bg);
    color: rgba(255,255,255,0.85);
    margin-top: 24px;
  }

  .footer__main {
    padding: 36px 0 28px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr 1.2fr;
    gap: 32px;
  }

  /* Headings */
  .footer__heading {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-white);
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 2px solid rgba(255,255,255,0.15);
  }

  .footer__subheading {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-white);
    margin-top: 16px;
    margin-bottom: 10px;
  }

  /* Company info list */
  .footer__info-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer__info-item {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .footer__info-icon {
    flex-shrink: 0;
    margin-top: 2px;
    opacity: 0.7;
  }

  .footer__link {
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer__link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  .footer__link--phone {
    font-weight: 600;
    color: #f6c90e;
  }

  .footer__link--phone:hover {
    color: #ffe566;
  }

  /* Nav lists */
  .footer__nav-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer__nav-link {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    transition: color 0.15s;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .footer__nav-link::before {
    content: '›';
    color: rgba(255,255,255,0.4);
  }

  .footer__nav-link:hover {
    color: var(--color-white);
  }

  /* Certification badge */
  .footer__cert-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    margin-bottom: 4px;
  }

  .footer__cert-icon {
    color: #f6c90e;
    flex-shrink: 0;
  }

  .footer__cert-text {
    display: flex;
    flex-direction: column;
  }

  .footer__cert-line1 {
    font-size: 0.68rem;
    font-weight: 700;
    color: rgba(255,255,255,0.8);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .footer__cert-line2 {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-white);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Social icons */
  .footer__social {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .footer__social-icon {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    text-decoration: none;
    transition: opacity 0.15s, transform 0.15s;
  }

  .footer__social-icon:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  .footer__social-icon--facebook { background: #1877f2; }
  .footer__social-icon--twitter { background: #1da1f2; }
  .footer__social-icon--linkedin { background: #0a66c2; }
  .footer__social-icon--youtube { background: #ff0000; }

  /* Bottom bar */
  .footer__bottom {
    background: rgba(0,0,0,0.25);
    padding: 12px 0;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .footer__copyright {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.6);
    text-align: center;
  }

  .footer__copyright-link {
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    font-weight: 500;
  }

  .footer__copyright-link:hover {
    text-decoration: underline;
    color: var(--color-white);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 568px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .footer__main {
      padding: 24px 0 20px;
    }
  }
</style>
