---
// Footer — dark navy with 4 columns
---

<footer class="footer">
  <div class="footer__main">
    <div class="container">
      <div class="footer__grid">

        <!-- Column 1: Company info -->
        <div class="footer__col">
          <h3 class="footer__heading">CÔNG TY CP VIỄN THÔNG Á CHÂU</h3>
