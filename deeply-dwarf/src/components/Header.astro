---
// Header component — logo and search bar
---

<header class="header">
  <div class="container">
    <div class="header__inner">
      <!-- Logo -->
      <a href="/" class="header__logo">
        <div class="header__logo-icon">
          <svg viewBox="0 0 40 40" width="40" height="40" fill="none">
            <rect width="40" height="40" rx="6" fill="#e63946"/>
            <text x="50%" y="56%" dominant-baseline="middle" text-anchor="middle" font-size="18" font-weight="900" fill="white" font-family="Roboto,Arial,sans-serif">ST</text>
          </svg>
        </div>
        <div class="header__logo-text">
          <span class="header__logo-main">Sieuthivienthong.com</span>
          <span class="header__logo-sub">SẢN PHẨM GIÁ GỐC - GIAO HÀNG TẬN NƠI</span>
        </div>
      </a>

      <!-- Search bar -->
      <div class="header__search">
        <form class="search-form" action="/search" method="get">
          <input
            type="text"
            name="q"
            class="search-form__input"
            placeholder="Tìm kiếm sản phẩm... (tên, mã SP, thương hiệu)"
            autocomplete="off"
          />
          <button type="submit" class="search-form__btn" aria-label="Tìm kiếm">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
            Tìm kiếm
          </button>
        </form>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    padding: 14px 0;
    box-shadow: var(--shadow-sm);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Logo */
  .header__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    min-width: 220px;
  }

  .header__logo-icon {
    flex-shrink: 0;
  }

  .header__logo-text {
    display: flex;
    flex-direction: column;
  }

  .header__logo-main {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-red);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .header__logo-sub {
    font-size: 0.62rem;
    color: var(--color-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  /* Search */
  .header__search {
    flex: 1;
    max-width: 600px;
  }

  .search-form {
    display: flex;
    height: 40px;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .search-form__input {
    flex: 1;
    padding: 0 14px;
    font-size: var(--font-size-base);
    border: none;
    outline: none;
    color: var(--color-text);
    background: var(--color-white);
  }

  .search-form__input::placeholder {
    color: #aaa;
    font-size: 0.82rem;
  }

  .search-form__btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 16px;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: var(--font-size-base);
    font-weight: 500;
    font-family: inherit;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s;
  }

  .search-form__btn:hover {
    background: var(--color-primary-dark);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .header__logo { min-width: 160px; }
    .header__logo-main { font-size: 1rem; }
  }

  @media (max-width: 640px) {
    .header__inner {
      flex-wrap: wrap;
      gap: 12px;
    }
    .header__logo { order: 1; }
    .header__search { order: 2; width: 100%; max-width: 100%; flex-basis: 100%; }
  }
</style>
