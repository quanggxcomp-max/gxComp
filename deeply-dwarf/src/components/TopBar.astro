---
// TopBar component — dark gray strip at very top of page
---

<div class="topbar">
  <div class="container">
    <div class="topbar__inner">
      <!-- Left: address, email, phone -->
      <div class="topbar__left">
        <span class="topbar__item">
          <svg class="topbar__icon" viewBox="0 0 24 24" fill="currentColor" width="12" height="12">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          92K Nguyễn Thái Sơn - Phường Hạnh Thông - Tp.HCM
        </span>
        <span class="topbar__divider">|</span>
        <span class="topbar__item">
          <svg class="topbar__icon" viewBox="0 0 24 24" fill="currentColor" width="12" height="12">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          info@sieuthivienthong.com
        </span>
        <span class="topbar__divider">|</span>
        <span class="topbar__item">
          <svg class="topbar__icon" viewBox="0 0 24 24" fill="currentColor" width="12" height="12">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
          (028) 7300 1535
        </span>
      </div>

      <!-- Right: navigation links -->
      <nav class="topbar__right">
        <a href="/gioi-thieu" class="topbar__link">Giới thiệu</a>
        <span class="topbar__divider">|</span>
        <a href="/so-do-duong-di" class="topbar__link">Sơ đồ đường đi</a>
        <span class="topbar__divider">|</span>
        <a href="/chinh-sach" class="topbar__link">Chính sách</a>
      </nav>
    </div>
  </div>
</div>

<style>
  .topbar {
    background: var(--color-topbar-bg);
    color: var(--color-topbar-text);
    padding: 6px 0;
    font-size: 0.72rem;
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px;
  }

  .topbar__left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
    color: #cccccc;
  }

  .topbar__item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .topbar__icon {
    flex-shrink: 0;
    opacity: 0.8;
  }

  .topbar__divider {
    color: #666;
    padding: 0 2px;
  }

  .topbar__right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }

  .topbar__link {
    color: #cccccc;
    transition: color 0.15s;
    white-space: nowrap;
  }

  .topbar__link:hover {
    color: #ffffff;
  }

  .topbar__link--highlight {
    color: #f6c90e;
    font-weight: 500;
  }

  .topbar__link--highlight:hover {
    color: #ffe566;
  }

  @media (max-width: 768px) {
    .topbar__right {
      display: none;
    }
    .topbar__left {
      font-size: 0.68rem;
    }
  }
</style>
