---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import NavBar from '../components/NavBar.astro';
import SalesConsultant from '../components/SalesConsultant.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Dịch vụ lắp đặt - Gx công nghệ">
  <TopBar />
  <Header />
  <NavBar />

  <main class="main-content">
    <div class="container">

      <nav class="breadcrumb">
        <a href="/">🏠 Trang chủ</a> ›
        <span>Dịch vụ lắp đặt</span>
      </nav>

      <div class="page-layout">
        <div class="page-main">

          <!-- Hero banner -->
          <div class="install-hero">
            <div class="install-hero__text">
              <h1 class="install-hero__title">Dịch vụ lắp đặt chuyên nghiệp</h1>
              <p class="install-hero__sub">Đội ngũ kỹ thuật viên giàu kinh nghiệm — lắp đặt đúng kỹ thuật, bảo hành tận tâm</p>
              <a href="/lien-he" class="install-hero__btn">Yêu cầu báo giá lắp đặt</a>
            </div>
          </div>

          <!-- Dịch vụ -->
          <div class="page-card">
            <h2 class="section-title">Các dịch vụ lắp đặt</h2>

            <div class="services-grid">

              <div class="service-card">
                <div class="service-card__icon">🚪</div>
                <h3 class="service-card__title">Cổng tự động VDS</h3>
                <p class="service-card__desc">Lắp đặt cổng trượt, cổng mở tự động thương hiệu VDS Italy. Khảo sát, tư vấn, thi công và bảo trì định kỳ.</p>
                <ul class="service-card__list">
                  <li>Cổng trượt 1 cánh & 2 cánh</li>
                  <li>Cổng mở cánh tay đẩy</li>
                  <li>Cổng mở âm sàn</li>
                  <li>Tải trọng từ 300kg đến 2500kg</li>
                </ul>
              </div>

              <div class="service-card">
                <div class="service-card__icon">🚧</div>
                <h3 class="service-card__title">Barrier & Bollard tự động</h3>
                <p class="service-card__desc">Lắp đặt barrier kiểm soát xe vào ra cho bãi đỗ xe, chung cư, khu công nghiệp và trung tâm thương mại.</p>
                <ul class="service-card__list">
                  <li>Barrier cần từ 3m đến 6m</li>
                  <li>Tích hợp thẻ từ, camera</li>
                  <li>Bollard thụt lên thụt xuống</li>
                  <li>Kết nối hệ thống quản lý</li>
                </ul>
              </div>

              <div class="service-card">
                <div class="service-card__icon">🏪</div>
                <h3 class="service-card__title">Cửa cuộn & Cửa garage</h3>
                <p class="service-card__desc">Lắp đặt cửa cuộn tự động cho cửa hàng, nhà kho và cửa garage tự động cho nhà dân, biệt thự.</p>
                <ul class="service-card__list">
                  <li>Cửa cuộn motor VDS TONDO</li>
                  <li>Cửa garage motor VDS UTILE</li>
                  <li>Cửa trượt tự động SPEED PLUS</li>
                  <li>Tích hợp remote & app điều khiển</li>
                </ul>
              </div>

              <div class="service-card">
                <div class="service-card__icon">📷</div>
                <h3 class="service-card__title">Camera & Mạng an ninh</h3>
                <p class="service-card__desc">Thiết kế, lắp đặt hệ thống camera quan sát và mạng nội bộ cho nhà dân, văn phòng và doanh nghiệp.</p>
                <ul class="service-card__list">
                  <li>Camera IP trong nhà & ngoài trời</li>
                  <li>Đầu ghi hình NVR/DVR</li>
                  <li>Mạng LAN/WiFi doanh nghiệp</li>
                  <li>Hệ thống kiểm soát ra vào</li>
                </ul>
              </div>

            </div>
          </div>

          <!-- Quy trình -->
          <div class="page-card">
            <h2 class="section-title">Quy trình lắp đặt</h2>
            <div class="process-list">
              <div class="process-step">
                <div class="process-step__num">1</div>
                <div class="process-step__content">
                  <h3>Tiếp nhận & Khảo sát</h3>
                  <p>Tiếp nhận yêu cầu, khảo sát thực tế tại địa điểm lắp đặt để đánh giá điều kiện kỹ thuật.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="process-step__num">2</div>
                <div class="process-step__content">
                  <h3>Tư vấn & Báo giá</h3>
                  <p>Đề xuất giải pháp phù hợp, báo giá chi tiết thiết bị và nhân công lắp đặt trong vòng 24 giờ.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="process-step__num">3</div>
                <div class="process-step__content">
                  <h3>Thi công lắp đặt</h3>
                  <p>Kỹ thuật viên có chứng chỉ thi công đúng quy trình, đảm bảo an toàn và thẩm mỹ.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="process-step__num">4</div>
                <div class="process-step__content">
                  <h3>Nghiệm thu & Bàn giao</h3>
                  <p>Kiểm tra vận hành, hướng dẫn sử dụng và bàn giao hồ sơ bảo hành đầy đủ.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="process-step__num">5</div>
                <div class="process-step__content">
                  <h3>Bảo trì định kỳ</h3>
                  <p>Hỗ trợ kỹ thuật từ xa và bảo trì định kỳ theo hợp đồng để thiết bị luôn hoạt động tốt.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Cam kết -->
          <div class="page-card commitments">
            <h2 class="section-title">Cam kết của chúng tôi</h2>
            <div class="commit-grid">
              <div class="commit-item">
                <span class="commit-icon">✅</span>
                <span>Thiết bị chính hãng VDS Italy 100%</span>
              </div>
              <div class="commit-item">
                <span class="commit-icon">🛡️</span>
                <span>Bảo hành thiết bị 24 tháng</span>
              </div>
              <div class="commit-item">
                <span class="commit-icon">⚡</span>
                <span>Hỗ trợ kỹ thuật 24/7</span>
              </div>
              <div class="commit-item">
                <span class="commit-icon">💰</span>
                <span>Báo giá minh bạch, không phát sinh</span>
              </div>
              <div class="commit-item">
                <span class="commit-icon">🔧</span>
                <span>Kỹ thuật viên được đào tạo chính hãng</span>
              </div>
              <div class="commit-item">
                <span class="commit-icon">📞</span>
                <span>Phản hồi trong vòng 2 giờ làm việc</span>
              </div>
            </div>
          </div>

        </div>

        <aside class="page-sidebar">
          <SalesConsultant />

          <div class="contact-widget">
            <div class="contact-widget__header">LIÊN HỆ LẮP ĐẶT</div>
            <div class="contact-widget__item">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
              <div>
                <p class="contact-label">Hotline lắp đặt</p>
                <a href="tel:02873001535">(028) 7300 1535</a>
              </div>
            </div>
            <div class="contact-widget__item">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
              <div>
                <p class="contact-label">Email</p>
                <a href="mailto:info@gxcompany.com">info@gxcompany.com</a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .main-content { padding: 16px 0 24px; }
  .breadcrumb { font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 16px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .breadcrumb a { color: var(--color-primary); text-decoration: none; }
  .breadcrumb span { color: var(--color-primary); font-weight: 500; }

  .page-layout { display: flex; gap: 16px; align-items: flex-start; }
  .page-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .page-sidebar { flex-shrink: 0; width: 240px; display: flex; flex-direction: column; gap: 14px; position: sticky; top: 50px; }

  /* Hero */
  .install-hero { background: linear-gradient(135deg, #0a4a7e 0%, #1a6fb3 100%); border-radius: var(--radius-md); padding: 36px 32px; color: white; }
  .install-hero__title { font-size: 1.6rem; font-weight: 700; margin-bottom: 10px; }
  .install-hero__sub { font-size: 0.92rem; opacity: 0.85; margin-bottom: 20px; line-height: 1.5; }
  .install-hero__btn { display: inline-flex; align-items: center; padding: 10px 24px; background: var(--color-red); color: white; border-radius: var(--radius-sm); font-weight: 700; font-size: 0.9rem; text-decoration: none; transition: background 0.15s; }
  .install-hero__btn:hover { background: var(--color-red-dark); }

  /* Page card */
  .page-card { background: white; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 24px; }

  /* Services grid */
  .services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 16px; }
  .service-card { background: #f8fafd; border: 1px solid #e0ecf8; border-radius: var(--radius-md); padding: 18px; }
  .service-card__icon { font-size: 2rem; margin-bottom: 10px; }
  .service-card__title { font-size: 0.95rem; font-weight: 700; color: var(--color-text); margin-bottom: 8px; }
  .service-card__desc { font-size: 0.82rem; color: var(--color-text-light); line-height: 1.6; margin-bottom: 10px; }
  .service-card__list { list-style: none; padding: 0; }
  .service-card__list li { font-size: 0.8rem; color: var(--color-text-light); padding: 3px 0; padding-left: 14px; position: relative; }
  .service-card__list li::before { content: '✓'; position: absolute; left: 0; color: var(--color-primary); font-weight: 700; }

  /* Process */
  .process-list { display: flex; flex-direction: column; gap: 14px; margin-top: 16px; }
  .process-step { display: flex; gap: 14px; align-items: flex-start; }
  .process-step__num { flex-shrink: 0; width: 32px; height: 32px; background: var(--color-primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.82rem; font-weight: 700; }
  .process-step__content h3 { font-size: 0.92rem; font-weight: 700; color: var(--color-text); margin-bottom: 4px; }
  .process-step__content p { font-size: 0.82rem; color: var(--color-text-light); line-height: 1.6; margin: 0; }

  /* Commitments */
  .commit-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 16px; }
  .commit-item { display: flex; align-items: center; gap: 10px; padding: 12px; background: #f8fafd; border-radius: var(--radius-sm); font-size: 0.85rem; color: var(--color-text); }
  .commit-icon { font-size: 1.2rem; flex-shrink: 0; }

  /* Contact widget */
  .contact-widget { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; }
  .contact-widget__header { background: var(--color-primary); color: white; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; padding: 10px 14px; letter-spacing: 0.04em; }
  .contact-widget__item { display: flex; align-items: flex-start; gap: 10px; padding: 10px 14px; border-bottom: 1px solid #f0f0f0; }
  .contact-widget__item svg { flex-shrink: 0; color: var(--color-primary); margin-top: 2px; }
  .contact-widget__item a { color: var(--color-primary); font-weight: 600; font-size: 0.85rem; }
  .contact-label { font-size: 0.75rem; color: var(--color-text-muted); margin-bottom: 2px; }

  @media (max-width: 768px) {
    .page-layout { flex-direction: column; }
    .page-sidebar { width: 100%; position: static; }
    .services-grid { grid-template-columns: 1fr; }
    .commit-grid { grid-template-columns: 1fr; }
    .install-hero { padding: 24px 20px; }
    .install-hero__title { font-size: 1.3rem; }
  }
</style>
