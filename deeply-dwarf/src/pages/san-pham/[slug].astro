---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import NavBar from '../../components/NavBar.astro';
import SalesConsultant from '../../components/SalesConsultant.astro';
import Footer from '../../components/Footer.astro';
import { getAllProductsForPages } from '../../lib/contentful/queries';
import type { ProductCardData } from '../../lib/contentful/types';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const allProducts = await getAllProductsForPages();
  return allProducts.map((product) => ({
    params: { slug: product.slug },
    props: {
      product,
      allProducts,
    },
  }));
}

interface Props {
  product: ProductCardData;
  allProducts: ProductCardData[];
}

const { product, allProducts } = Astro.props;
const related = allProducts
  .filter((p) => p.categorySlug === product.categorySlug && p.slug !== product.slug)
  .slice(0, 4);
---

<Layout title={product.name + ' - Gx công nghệ'}>
  <TopBar />
  <Header />
  <NavBar />

  <main class="main-content">
    <div class="container">

      <nav class="breadcrumb">
        <a href="/">🏠 Trang chủ</a> ›
        {product.categorySlug ? (
          <a href={`/danh-muc/${product.categorySlug}`}>{product.category}</a>
        ) : (
          <span>{product.category}</span>
        )} ›
        <span>{product.name}</span>
      </nav>

      <div class="detail-layout">

        <!-- LEFT: main content -->
        <div class="detail-main">

          <!-- Product top section -->
          <div class="product-detail-card">
            <div class="product-detail-top">

              <!-- Product image -->
              <div class="product-detail-image">
                {product.discount && <span class="badge-sale">-{product.discount}%</span>}
                <img src={product.image} alt={product.name} width="400" height="300" />
              </div>

              <!-- Product info -->
              <div class="product-detail-info">
                <h1 class="product-detail-name">{product.name}</h1>
                <p class="product-detail-code">Mã SP: <span>{product.code}</span></p>
                {product.brand    && <p class="product-detail-meta">Hãng SX: <strong>{product.brand}</strong></p>}
                {product.warranty && <p class="product-detail-meta">Bảo hành: <strong>{product.warranty}</strong></p>}

                <!-- Giá tham khảo -->
                <div class="product-detail-price-block">
                  <span class="product-detail-price">{product.price}</span>
                  {product.originalPrice && <span class="product-detail-original">{product.originalPrice}</span>}
                </div>
                {product.discount && <p class="product-detail-saving">Tiết kiệm: {product.discount}%</p>}
                {product.promotion && <p class="product-detail-promo">🎁 {product.promotion}</p>}

                <!-- CTA liên hệ thay vì mua hàng -->
                <div class="product-detail-cta">
                  <a href="/lien-he" class="btn-contact">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
                    Liên hệ tư vấn
                  </a>
                  <a href={`tel:${site.sales.tel}`} class="btn-call">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
                    {site.sales.display}
                  </a>
                </div>

                <!-- Trust badges -->
                <div class="trust-badges">
                  <div class="trust-badge">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                    <span>Chính hãng<br/>100%</span>
                  </div>
                  <div class="trust-badge">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/></svg>
                    <span>Bảo hành<br/>tận tâm</span>
                  </div>
                  <div class="trust-badge">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm4.24 16L12 15.45 7.77 18l1.12-4.81-3.73-3.23 4.92-.42L12 5l1.92 4.53 4.92.42-3.73 3.23L16.23 18z"/></svg>
                    <span>Hỗ trợ<br/>24/7</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tabs: Mô tả / Thông số -->
          <div class="product-tabs-card">
            <div class="tab-header">
              <button class="tab-btn tab-btn--active" onclick="switchTab(this,'desc')">Mô tả sản phẩm</button>
              <button class="tab-btn" onclick="switchTab(this,'specs')">Thông số kỹ thuật</button>
            </div>

            <div class="tab-content" id="tab-desc">
              <div class="product-description">
                <p>- Sản phẩm chính hãng {product.brand}, xuất xứ Italy, chất lượng cao.</p>
                <p>- Bảo hành {product.warranty} tại trung tâm bảo hành ủy quyền.</p>
                <p>- Hỗ trợ kỹ thuật và lắp đặt tận nơi tại Hà Nội và toàn quốc.</p>
                <p>- Liên hệ để được tư vấn giải pháp phù hợp với nhu cầu thực tế.</p>
              </div>
            </div>

            <div class="tab-content tab-content--hidden" id="tab-specs">
              <table class="specs-table">
                <tbody>
                  <tr><td>Thương hiệu</td><td>{product.brand}</td></tr>
                  <tr><td>Mã sản phẩm</td><td>{product.code}</td></tr>
                  <tr><td>Danh mục</td><td>{product.category}</td></tr>
                  <tr><td>Bảo hành</td><td>{product.warranty}</td></tr>
                  <tr><td>Xuất xứ</td><td>Italy (VDS Automation)</td></tr>
                  <tr><td>Tình trạng</td><td>Còn hàng</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- FAQ -->
          <div class="faq-card">
            <h2 class="faq-title">Câu hỏi thường gặp</h2>
            <div class="faq-item">
              <h3 class="faq-question">{product.name} có bảo hành không?</h3>
              <p class="faq-answer">Có, sản phẩm được bảo hành {product.warranty} kể từ ngày lắp đặt. Đội kỹ thuật hỗ trợ bảo trì định kỳ và xử lý sự cố trong suốt thời gian bảo hành.</p>
            </div>
            <div class="faq-item">
              <h3 class="faq-question">Có dịch vụ lắp đặt tận nơi không?</h3>
              <p class="faq-answer">Có, chúng tôi cung cấp dịch vụ lắp đặt tận nơi tại Hà Nội và các tỉnh lân cận. Liên hệ hotline {site.sales.display} để được khảo sát và báo giá miễn phí.</p>
            </div>
            <div class="faq-item">
              <h3 class="faq-question">Giá sản phẩm đã bao gồm lắp đặt chưa?</h3>
              <p class="faq-answer">Giá niêm yết là giá tham khảo cho thiết bị. Chi phí lắp đặt sẽ được báo giá riêng sau khi khảo sát thực tế tùy theo địa điểm và yêu cầu kỹ thuật.</p>
            </div>
          </div>

          <!-- Related products -->
          {related.length > 0 && (
            <div class="related-card">
              <h2 class="section-title">Sản phẩm liên quan</h2>
              <div class="related-grid">
                {related.map(r => (
                  <a href={`/san-pham/${r.slug}`} class="related-item">
                    {r.discount && <span class="badge-sale related-badge">-{r.discount}%</span>}
                    <div class="related-img">
                      <img src={r.image} alt={r.name} width="200" height="150" loading="lazy" />
                    </div>
                    <div class="related-info">
                      <p class="related-name">{r.name}</p>
                      <p class="related-code">Mã SP: {r.code}</p>
                      <p class="related-price">{r.price}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

        </div>

        <!-- RIGHT: sidebar -->
        <aside class="detail-sidebar">

          <!-- Giá tham khảo box -->
          <div class="sidebar-price-box">
            <p class="sidebar-label">Giá tham khảo</p>
            <div class="sidebar-price">{product.price}</div>
            {product.originalPrice && <p class="sidebar-original">{product.originalPrice}</p>}
            {product.discount && <p class="sidebar-saving">Tiết kiệm: {product.discount}%</p>}
            <p class="sidebar-note">* Giá chưa bao gồm phí lắp đặt</p>
            <a href="/lien-he" class="sidebar-contact-btn">
              Liên hệ báo giá
            </a>
            <a href={`tel:${site.sales.tel}`} class="sidebar-call-btn">
              📞 {site.sales.display}
            </a>
          </div>

          <!-- Trust badges -->
          <div class="sidebar-trust">
            <div class="trust-badge">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
              <span>Chính hãng</span>
            </div>
            <div class="trust-badge">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/></svg>
              <span>Bảo hành</span>
            </div>
            <div class="trust-badge">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm4.24 16L12 15.45 7.77 18l1.12-4.81-3.73-3.23 4.92-.42L12 5l1.92 4.53 4.92.42-3.73 3.23L16.23 18z"/></svg>
              <span>Hỗ trợ 24/7</span>
            </div>
          </div>

          <SalesConsultant />

          <!-- Contact widget -->
          <div class="contact-widget">
            <div class="contact-widget__header">LIÊN HỆ VÀ HỖ TRỢ</div>
            <div class="contact-widget__item">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
              <div>
                <p class="contact-label">Tư vấn & Báo giá</p>
                <a href={`tel:${site.sales.tel}`}>{site.sales.display}</a>
              </div>
            </div>
            <div class="contact-widget__item">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
              <div>
                <p class="contact-label">Hỗ trợ kỹ thuật</p>
                <a href={`tel:${site.support.tel}`}>{site.support.display}</a>
              </div>
            </div>
          </div>

        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .main-content { padding: 12px 0 0; }

  .breadcrumb { font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 14px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .breadcrumb a { color: var(--color-primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { color: var(--color-primary); font-weight: 500; }

  .detail-layout { display: flex; gap: 16px; align-items: flex-start; }
  .detail-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .detail-sidebar { flex-shrink: 0; width: 260px; display: flex; flex-direction: column; gap: 12px; position: sticky; top: 50px; }

  .product-detail-card, .product-tabs-card, .faq-card, .related-card {
    background: var(--color-white); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: 20px;
  }

  /* Product top */
  .product-detail-top { display: flex; gap: 24px; align-items: flex-start; }
  .product-detail-image { flex-shrink: 0; width: 300px; position: relative; }
  .product-detail-image .badge-sale { position: absolute; top: 10px; left: 10px; font-size: 0.85rem; padding: 3px 8px; z-index: 2; }
  .product-detail-image img { width: 100%; border-radius: var(--radius-md); border: 1px solid var(--color-border); }
  .product-detail-info { flex: 1; }
  .product-detail-name { font-size: 1.25rem; font-weight: 700; color: var(--color-text); margin-bottom: 10px; line-height: 1.3; }
  .product-detail-code { font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 4px; }
  .product-detail-code span { color: var(--color-primary); font-weight: 500; }
  .product-detail-meta { font-size: 0.88rem; color: var(--color-text); margin-bottom: 4px; }
  .product-detail-meta strong { color: var(--color-primary); }
  .product-detail-price-block { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin: 14px 0 4px; }
  .product-detail-price { font-size: 1.5rem; font-weight: 700; color: var(--color-red); }
  .product-detail-original { font-size: 0.9rem; color: var(--color-text-muted); text-decoration: line-through; }
  .product-detail-saving { font-size: 0.82rem; color: var(--color-text-light); margin-bottom: 6px; }
  .product-detail-promo { font-size: 0.82rem; color: var(--color-orange); margin-bottom: 10px; font-weight: 500; }

  /* CTA buttons */
  .product-detail-cta { display: flex; gap: 10px; flex-wrap: wrap; margin: 16px 0; }
  .btn-contact { display: inline-flex; align-items: center; gap: 7px; padding: 10px 20px; background: var(--color-primary); color: white; border-radius: var(--radius-sm); font-size: 0.88rem; font-weight: 700; text-decoration: none; transition: background 0.15s; }
  .btn-contact:hover { background: var(--color-primary-dark); }
  .btn-call { display: inline-flex; align-items: center; gap: 7px; padding: 10px 20px; background: #25d366; color: white; border-radius: var(--radius-sm); font-size: 0.88rem; font-weight: 700; text-decoration: none; transition: background 0.15s; }
  .btn-call:hover { background: #1ebc58; }

  /* Trust badges */
  .trust-badges { display: flex; gap: 16px; padding: 12px 14px; background: #f8fafd; border-radius: var(--radius-md); border: 1px solid #e0ecf8; }
  .trust-badge { display: flex; flex-direction: column; align-items: center; gap: 5px; text-align: center; color: var(--color-primary); font-size: 0.7rem; font-weight: 600; line-height: 1.3; min-width: 56px; }

  /* Tabs */
  .tab-header { display: flex; border-bottom: 2px solid var(--color-border); margin-bottom: 16px; }
  .tab-btn { padding: 10px 20px; background: none; border: none; border-bottom: 3px solid transparent; margin-bottom: -2px; font-size: 0.9rem; font-weight: 600; color: var(--color-text-muted); cursor: pointer; transition: all 0.15s; font-family: inherit; }
  .tab-btn--active { color: var(--color-primary); border-bottom-color: var(--color-primary); }
  .tab-btn:hover { color: var(--color-primary); }
  .tab-content--hidden { display: none; }
  .product-description p { margin-bottom: 8px; font-size: 0.88rem; line-height: 1.6; color: var(--color-text-light); }

  /* Specs */
  .specs-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .specs-table tr:nth-child(even) td { background: #f8f8f8; }
  .specs-table td { padding: 9px 14px; border: 1px solid #eee; }
  .specs-table td:first-child { width: 40%; color: var(--color-text-light); font-weight: 500; }

  /* FAQ */
  .faq-title { font-size: 1.05rem; font-weight: 700; margin-bottom: 16px; }
  .faq-item { margin-bottom: 14px; border-bottom: 1px solid #f0f0f0; padding-bottom: 14px; }
  .faq-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .faq-question { font-size: 0.9rem; font-weight: 700; color: var(--color-text); margin-bottom: 6px; }
  .faq-answer { font-size: 0.84rem; color: var(--color-text-light); line-height: 1.6; }

  /* Related */
  .related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .related-item { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; text-decoration: none; color: inherit; transition: var(--transition); position: relative; display: block; }
  .related-item:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); border-color: var(--color-primary); }
  .related-badge { position: absolute; top: 6px; left: 6px; z-index: 2; }
  .related-img { background: #f8f8f8; padding: 12px; display: flex; align-items: center; justify-content: center; height: 120px; }
  .related-img img { max-height: 96px; width: auto; object-fit: contain; }
  .related-info { padding: 10px; }
  .related-name { font-size: 0.78rem; font-weight: 500; color: var(--color-text); line-height: 1.4; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .related-code { font-size: 0.7rem; color: var(--color-text-muted); margin-bottom: 4px; }
  .related-price { font-size: 0.85rem; font-weight: 700; color: var(--color-red); }

  /* Sidebar price box */
  .sidebar-price-box { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 16px; }
  .sidebar-label { font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.04em; margin-bottom: 6px; }
  .sidebar-price { font-size: 1.4rem; font-weight: 700; color: var(--color-red); }
  .sidebar-original { font-size: 0.82rem; color: var(--color-text-muted); text-decoration: line-through; margin-top: 2px; }
  .sidebar-saving { font-size: 0.78rem; color: var(--color-text-light); margin-top: 2px; }
  .sidebar-note { font-size: 0.72rem; color: var(--color-text-muted); margin: 8px 0 14px; font-style: italic; }
  .sidebar-contact-btn { display: block; width: 100%; padding: 10px; background: var(--color-primary); color: white; border-radius: var(--radius-sm); font-size: 0.88rem; font-weight: 700; text-align: center; text-decoration: none; margin-bottom: 8px; transition: background 0.15s; }
  .sidebar-contact-btn:hover { background: var(--color-primary-dark); }
  .sidebar-call-btn { display: block; width: 100%; padding: 10px; background: #25d366; color: white; border-radius: var(--radius-sm); font-size: 0.88rem; font-weight: 700; text-align: center; text-decoration: none; transition: background 0.15s; }
  .sidebar-call-btn:hover { background: #1ebc58; }

  /* Sidebar trust */
  .sidebar-trust { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 12px; display: flex; justify-content: space-around; }

  /* Contact widget */
  .contact-widget { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; }
  .contact-widget__header { background: var(--color-primary); color: white; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; padding: 10px 14px; letter-spacing: 0.04em; }
  .contact-widget__item { display: flex; align-items: flex-start; gap: 10px; padding: 10px 14px; border-bottom: 1px solid #f0f0f0; }
  .contact-widget__item:last-child { border-bottom: none; }
  .contact-widget__item svg { flex-shrink: 0; color: var(--color-primary); margin-top: 2px; }
  .contact-widget__item a { color: var(--color-primary); font-weight: 600; font-size: 0.85rem; }
  .contact-label { font-size: 0.75rem; color: var(--color-text-muted); margin-bottom: 2px; }

  @media (max-width: 1024px) {
    .detail-sidebar { width: 220px; }
    .product-detail-image { width: 240px; }
    .related-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .detail-layout { flex-direction: column; }
    .detail-sidebar { width: 100%; position: static; }
    .product-detail-top { flex-direction: column; }
    .product-detail-image { width: 100%; max-width: 320px; margin: 0 auto; }
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
function switchTab(btn: HTMLButtonElement, tabId: string) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('tab-btn--active'));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.add('tab-content--hidden'));
  btn.classList.add('tab-btn--active');
  document.getElementById('tab-' + tabId)?.classList.remove('tab-content--hidden');
}
(window as any).switchTab = switchTab;
</script>
