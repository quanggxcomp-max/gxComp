---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import NavBar from '../../components/NavBar.astro';
import SalesConsultant from '../../components/SalesConsultant.astro';
import Footer from '../../components/Footer.astro';
import { getAllProductsForPages } from '../../lib/contentful/queries';
import { productPlaceholderImage } from '../../lib/contentful/mappers';
import type { ProductCardData } from '../../lib/contentful/types';

export async function getStaticPaths() {
  const allProducts = await getAllProductsForPages();

  return allProducts.map((product) => ({
    params: { slug: product.slug },
    props: {
      product: {
        ...product,
        image: productPlaceholderImage(product.name, '400x300'),
      },
      allProducts,
    },
  }));
}

interface Props {
  product: ProductCardData;
  allProducts: ProductCardData[];
}

const { product, allProducts } = Astro.props;
const related = allProducts
  .filter((p) => p.categorySlug === product.categorySlug && p.slug !== product.slug)
  .slice(0, 4);
---

<Layout title={product.name + ' - Siêu Thị Viễn Thông'}>
  <TopBar />
  <Header />
  <NavBar />

  <main class="main-content">
    <div class="container">

      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href="/">🏠 Trang chủ</a> ›
        {product.categorySlug ? (
          <a href={`/danh-muc/${product.categorySlug}`}>{product.category}</a>
        ) : (
          <span>{product.category}</span>
        )} ›
        <span>{product.name}</span>
      </nav>

      <div class="detail-layout">

        <!-- LEFT: main content -->
        <div class="detail-main">

          <!-- Product top section -->
          <div class="product-detail-card">
            <div class="product-detail-top">
              <!-- Product image -->
              <div class="product-detail-image">
                {product.discount && <span class="badge-sale">-{product.discount}%</span>}
                <img src={product.image} alt={product.name} width="400" height="300" />
              </div>

              <!-- Product info -->
              <div class="product-detail-info">
                <h1 class="product-detail-name">{product.name}</h1>
                <p class="product-detail-code">Mã SP: <span>{product.code}</span></p>
                <p class="product-detail-brand">Hãng SX: <a href="#">{product.brand}</a></p>
                <p class="product-detail-warranty">Bảo hành: <a href="#">{product.warranty}</a></p>

                <div class="product-detail-price-block">
                  <span class="product-detail-price">{product.price}</span>
                  {product.originalPrice && <span class="product-detail-original">{product.originalPrice}</span>}
                  <span class="product-detail-vat">(Đã bao gồm VAT)</span>
                </div>
                {product.discount && <p class="product-detail-saving">Tiết kiệm: {product.discount}%</p>}

                <!-- Quantity + Add to cart -->
                <div class="product-detail-actions">
                  <div class="qty-control">
                    <button class="qty-btn" onclick="this.nextElementSibling.value=Math.max(1,+this.nextElementSibling.value-1)">−</button>
                    <input type="number" value="1" min="1" class="qty-input" />
                    <button class="qty-btn" onclick="this.previousElementSibling.value=+this.previousElementSibling.value+1">+</button>
                  </div>
                  <button class="btn-add-cart">
                    🛒 THÊM VÀO GIỎ
                  </button>
                  <button class="btn-buy-now">
                    ⚡ MUA NGAY
                  </button>
                </div>

                <!-- Trust badges -->
                <div class="trust-badges">
                  <div class="trust-badge">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                    <span>Sản phẩm<br/>chính hãng</span>
                  </div>
                  <div class="trust-badge">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    <span>Hàng mới<br/>100%</span>
                  </div>
                  <div class="trust-badge">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/></svg>
                    <span>Bảo hành<br/>tận tâm</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Description + Specs tabs -->
          <div class="product-tabs-card">
            <div class="tab-header">
              <button class="tab-btn tab-btn--active" onclick="switchTab(this,'desc')">Mô tả sản phẩm</button>
              <button class="tab-btn" onclick="switchTab(this,'specs')">Thông số kỹ thuật</button>
            </div>

            <div class="tab-content" id="tab-desc">
              <div class="product-description">
                <p>- Sản phẩm chính hãng {product.brand}, chất lượng cao.</p>
                <p>- Bảo hành {product.warranty} tại trung tâm bảo hành ủy quyền.</p>
                <p>- Giao hàng toàn quốc, hỗ trợ kỹ thuật 24/7.</p>
                <p>- Phù hợp cho gia đình và doanh nghiệp.</p>
              </div>
            </div>

            <div class="tab-content tab-content--hidden" id="tab-specs">
              <table class="specs-table">
                <tbody>
                  <tr><td>Thương hiệu</td><td>{product.brand}</td></tr>
                  <tr><td>Mã sản phẩm</td><td>{product.code}</td></tr>
                  <tr><td>Danh mục</td><td>{product.category}</td></tr>
                  <tr><td>Bảo hành</td><td>{product.warranty}</td></tr>
                  <tr><td>Xuất xứ</td><td>Chính hãng</td></tr>
                  <tr><td>Tình trạng</td><td>Còn hàng</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- FAQ section -->
          <div class="faq-card">
            <h2 class="faq-title">Câu hỏi thường gặp</h2>
            <div class="faq-item">
              <h3 class="faq-question">{product.name} có bảo hành không?</h3>
              <p class="faq-answer">Có, sản phẩm được bảo hành {product.warranty} tại trung tâm bảo hành ủy quyền của {product.brand} trên toàn quốc.</p>
            </div>
            <div class="faq-item">
              <h3 class="faq-question">Sản phẩm có hỗ trợ giao hàng toàn quốc không?</h3>
              <p class="faq-answer">Có, chúng tôi giao hàng toàn quốc qua các đơn vị vận chuyển uy tín. Miễn phí giao hàng cho đơn hàng từ 500.000₫ tại TP.HCM.</p>
            </div>
            <div class="faq-item">
              <h3 class="faq-question">Có thể đổi trả sản phẩm không?</h3>
              <p class="faq-answer">Có, sản phẩm được đổi trả trong vòng 7 ngày nếu có lỗi từ nhà sản xuất. Vui lòng liên hệ hotline (028) 7300 1535 để được hỗ trợ.</p>
            </div>
          </div>

          <!-- Related products -->
          {related.length > 0 && (
            <div class="related-card">
              <h2 class="section-title">Sản phẩm liên quan</h2>
              <div class="related-grid">
                {related.map(r => (
                  <a href={`/san-pham/${r.slug}`} class="related-item">
                    {r.discount && <span class="badge-sale related-badge">-{r.discount}%</span>}
                    <div class="related-img">
                      <img src={r.image} alt={r.name} width="200" height="150" loading="lazy" />
                    </div>
                    <div class="related-info">
                      <p class="related-name">{r.name}</p>
                      <p class="related-code">Mã SP: {r.code}</p>
                      <p class="related-price">{r.price}</p>
                      {r.originalPrice && <p class="related-original">{r.originalPrice}</p>}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

        </div>

        <!-- RIGHT: sticky sidebar -->
        <aside class="detail-sidebar">
          <!-- Sticky price box -->
          <div class="sidebar-price-box">
            <p class="sidebar-product-name">{product.name}</p>
            <div class="sidebar-price">{product.price}</div>
            {product.originalPrice && <p class="sidebar-original">{product.originalPrice}</p>}
            {product.discount && <p class="sidebar-saving">Tiết kiệm: {product.discount}%</p>}
            <div class="sidebar-vat">(Đã bao gồm VAT)</div>
            <div class="sidebar-qty">
              <button class="qty-btn" onclick="this.nextElementSibling.value=Math.max(1,+this.nextElementSibling.value-1)">−</button>
              <input type="number" value="1" min="1" class="qty-input" />
              <button class="qty-btn" onclick="this.previousElementSibling.value=+this.previousElementSibling.value+1">+</button>
            </div>
            <button class="sidebar-add-cart">Thêm vào giỏ</button>
          </div>

          <!-- Trust badges sidebar -->
          <div class="sidebar-trust">
            <div class="trust-badge">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
              <span>Sản phẩm<br/>chính hãng</span>
            </div>
            <div class="trust-badge">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span>Hàng mới<br/>100%</span>
            </div>
            <div class="trust-badge">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/></svg>
              <span>Bảo hành<br/>tận tâm</span>
            </div>
          </div>

          <SalesConsultant />

          <!-- Contact widget -->
          <div class="contact-widget">
            <div class="contact-widget__header">LIÊN HỆ VÀ HỖ TRỢ</div>
            <div class="contact-widget__item">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
              <div>
                <p class="contact-label">Liên hệ mua hàng</p>
                <a href="tel:02873001535">(028) 7300 1535</a>
              </div>
            </div>
            <div class="contact-widget__item">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
              <div>
                <p class="contact-label">Hỗ trợ bảo hành</p>
                <a href="tel:02873002049">(028) 7300 2049</a>
              </div>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .main-content { padding: 12px 0 0; }

  /* Breadcrumb */
  .breadcrumb { font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 14px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .breadcrumb a { color: var(--color-primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { color: var(--color-primary); font-weight: 500; }

  /* 2-col layout */
  .detail-layout { display: flex; gap: 16px; align-items: flex-start; }
  .detail-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .detail-sidebar { flex-shrink: 0; width: 260px; display: flex; flex-direction: column; gap: 12px; position: sticky; top: 50px; }

  /* Card wrappers */
  .product-detail-card, .product-tabs-card, .faq-card, .related-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px;
  }

  /* Product top section */
  .product-detail-top { display: flex; gap: 24px; align-items: flex-start; }
  .product-detail-image { flex-shrink: 0; width: 320px; position: relative; }
  .product-detail-image .badge-sale { position: absolute; top: 10px; left: 10px; font-size: 0.85rem; padding: 3px 8px; z-index: 2; }
  .product-detail-image img { width: 100%; border-radius: var(--radius-md); border: 1px solid var(--color-border); }
  .product-detail-info { flex: 1; }
  .product-detail-name { font-size: 1.3rem; font-weight: 700; color: var(--color-text); margin-bottom: 12px; line-height: 1.3; }
  .product-detail-code { font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 4px; }
  .product-detail-code span { color: var(--color-primary); font-weight: 500; }
  .product-detail-brand, .product-detail-warranty { font-size: 0.88rem; color: var(--color-text); margin-bottom: 4px; }
  .product-detail-brand a, .product-detail-warranty a { color: var(--color-primary); }
  .product-detail-price-block { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin: 14px 0 4px; }
  .product-detail-price { font-size: 1.6rem; font-weight: 700; color: var(--color-red); }
  .product-detail-original { font-size: 0.9rem; color: var(--color-text-muted); text-decoration: line-through; }
  .product-detail-vat { font-size: 0.78rem; color: var(--color-text-muted); }
  .product-detail-saving { font-size: 0.85rem; color: var(--color-text-light); margin-bottom: 14px; }

  /* Actions */
  .product-detail-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; }
  .qty-control { display: flex; align-items: center; border: 1px solid var(--color-border); border-radius: var(--radius-sm); overflow: hidden; }
  .qty-btn { width: 32px; height: 36px; background: #f5f5f5; border: none; cursor: pointer; font-size: 1.1rem; font-weight: 600; color: var(--color-text); transition: background 0.15s; display: flex; align-items: center; justify-content: center; }
  .qty-btn:hover { background: #e8e8e8; }
  .qty-input { width: 46px; height: 36px; border: none; border-left: 1px solid var(--color-border); border-right: 1px solid var(--color-border); text-align: center; font-size: 0.9rem; font-weight: 600; font-family: inherit; }
  .btn-add-cart { padding: 8px 18px; background: var(--color-orange); color: white; border: none; border-radius: var(--radius-sm); font-size: 0.88rem; font-weight: 700; cursor: pointer; transition: background 0.15s; letter-spacing: 0.03em; }
  .btn-add-cart:hover { background: #d9720a; }
  .btn-buy-now { padding: 8px 18px; background: var(--color-primary); color: white; border: none; border-radius: var(--radius-sm); font-size: 0.88rem; font-weight: 700; cursor: pointer; transition: background 0.15s; letter-spacing: 0.03em; }
  .btn-buy-now:hover { background: var(--color-primary-dark); }

  /* Trust badges */
  .trust-badges { display: flex; gap: 20px; padding: 14px; background: #f8fafd; border-radius: var(--radius-md); border: 1px solid #e0ecf8; }
  .trust-badge { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; color: var(--color-primary); font-size: 0.72rem; font-weight: 600; line-height: 1.3; min-width: 64px; }
  .trust-badge svg { color: var(--color-primary); }

  /* Tabs */
  .tab-header { display: flex; border-bottom: 2px solid var(--color-border); margin-bottom: 16px; }
  .tab-btn { padding: 10px 20px; background: none; border: none; border-bottom: 3px solid transparent; margin-bottom: -2px; font-size: 0.9rem; font-weight: 600; color: var(--color-text-muted); cursor: pointer; transition: all 0.15s; }
  .tab-btn--active { color: var(--color-primary); border-bottom-color: var(--color-primary); }
  .tab-btn:hover { color: var(--color-primary); }
  .tab-content--hidden { display: none; }
  .product-description p { margin-bottom: 8px; font-size: 0.88rem; line-height: 1.6; }

  /* Specs table */
  .specs-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .specs-table tr:nth-child(even) td { background: #f8f8f8; }
  .specs-table td { padding: 9px 14px; border: 1px solid #eee; }
  .specs-table td:first-child { width: 40%; color: var(--color-text-light); font-weight: 500; }

  /* FAQ */
  .faq-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; }
  .faq-item { margin-bottom: 14px; border-bottom: 1px solid #f0f0f0; padding-bottom: 14px; }
  .faq-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .faq-question { font-size: 0.92rem; font-weight: 700; color: var(--color-text); margin-bottom: 6px; }
  .faq-answer { font-size: 0.85rem; color: var(--color-text-light); line-height: 1.6; }

  /* Related products */
  .related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .related-item { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; text-decoration: none; color: inherit; transition: var(--transition); position: relative; display: block; }
  .related-item:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); border-color: var(--color-primary); }
  .related-badge { position: absolute; top: 6px; left: 6px; z-index: 2; }
  .related-img { background: #f8f8f8; padding: 12px; display: flex; align-items: center; justify-content: center; height: 130px; }
  .related-img img { max-height: 100px; width: auto; object-fit: contain; }
  .related-info { padding: 10px; }
  .related-name { font-size: 0.78rem; font-weight: 500; color: var(--color-text); line-height: 1.4; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 2.5em; }
  .related-code { font-size: 0.7rem; color: var(--color-text-muted); margin-bottom: 4px; }
  .related-price { font-size: 0.88rem; font-weight: 700; color: var(--color-red); }
  .related-original { font-size: 0.72rem; color: var(--color-text-muted); text-decoration: line-through; }

  /* Sidebar price box */
  .sidebar-price-box { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 16px; }
  .sidebar-product-name { font-size: 0.82rem; font-weight: 600; color: var(--color-text); margin-bottom: 10px; line-height: 1.4; }
  .sidebar-price { font-size: 1.4rem; font-weight: 700; color: var(--color-red); }
  .sidebar-original { font-size: 0.82rem; color: var(--color-text-muted); text-decoration: line-through; margin-top: 2px; }
  .sidebar-saving { font-size: 0.8rem; color: var(--color-text-light); margin-top: 2px; }
  .sidebar-vat { font-size: 0.72rem; color: var(--color-text-muted); margin-bottom: 12px; }
  .sidebar-qty { display: flex; align-items: center; margin-bottom: 10px; }
  .sidebar-add-cart { width: 100%; padding: 10px; background: var(--color-orange); color: white; border: none; border-radius: var(--radius-sm); font-size: 0.9rem; font-weight: 700; cursor: pointer; transition: background 0.15s; }
  .sidebar-add-cart:hover { background: #d9720a; }

  /* Sidebar trust badges */
  .sidebar-trust { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 14px; display: flex; justify-content: space-around; }

  /* Contact widget */
  .contact-widget { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; }
  .contact-widget__header { background: var(--color-primary); color: white; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; padding: 10px 14px; letter-spacing: 0.04em; }
  .contact-widget__item { display: flex; align-items: flex-start; gap: 10px; padding: 10px 14px; border-bottom: 1px solid #f0f0f0; }
  .contact-widget__item svg { flex-shrink: 0; color: var(--color-primary); margin-top: 2px; }
  .contact-widget__item a { color: var(--color-primary); font-weight: 600; font-size: 0.85rem; }
  .contact-label { font-size: 0.75rem; color: var(--color-text-muted); margin-bottom: 2px; }

  /* Responsive */
  @media (max-width: 1024px) {
    .detail-sidebar { width: 220px; }
    .product-detail-image { width: 260px; }
    .related-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .detail-layout { flex-direction: column; }
    .detail-sidebar { width: 100%; position: static; }
    .product-detail-top { flex-direction: column; }
    .product-detail-image { width: 100%; max-width: 340px; margin: 0 auto; }
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
function switchTab(btn: HTMLButtonElement, tabId: string) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('tab-btn--active'));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.add('tab-content--hidden'));
  btn.classList.add('tab-btn--active');
  document.getElementById('tab-' + tabId)?.classList.remove('tab-content--hidden');
}
(window as any).switchTab = switchTab;
</script>
