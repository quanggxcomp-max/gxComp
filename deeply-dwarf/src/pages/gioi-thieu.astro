---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import NavBar from '../components/NavBar.astro';
import SalesConsultant from '../components/SalesConsultant.astro';
import Footer from '../components/Footer.astro';
import ContactSupport from '../components/ContactSupport.astro';
import logo from '../assets/logo.jpg';
import { site } from '../lib/site';
---

<Layout title="Giới thiệu - Gx công nghệ">
  <TopBar />
  <Header />
  <NavBar />

  <main class="main-content">
    <div class="container">

      <nav class="breadcrumb">
        <a href="/">🏠 Trang chủ</a> ›
        <span>Giới thiệu</span>
      </nav>

      <div class="page-layout">

        <div class="page-main">
          <div class="page-card">
            <h1 class="page-title">Giới thiệu công ty</h1>

            <div class="company-header">
              <div class="company-logo-area">
                <div class="company-logo-box">
                  <img src={logo.src} alt="GX Công Nghệ" width="72" height="72" />
                </div>
                <div>
                  <h2 class="company-name">Công ty Cổ phần Viễn Thông Á Châu</h2>
                  <p class="company-tagline">Sản phẩm giá gốc – Giao hàng tận nơi</p>
                </div>
              </div>
            </div>

            <h3 class="page-section-title">Về chúng tôi</h3>
            <p>Công ty Cổ phần Viễn Thông Á Châu (Gx công nghệ) được thành lập năm 2006, là đơn vị chuyên cung cấp các thiết bị camera quan sát, mạng máy tính, viễn thông, access control và các giải pháp công nghệ cho doanh nghiệp và gia đình tại TP.HCM và toàn quốc.</p>
            <p>Với hơn 18 năm kinh nghiệm trong lĩnh vực phân phối thiết bị công nghệ, chúng tôi tự hào là đối tác ủy quyền chính thức của các thương hiệu hàng đầu thế giới như HIKVISION, RUIJIE, SOROTEC, TP-Link, EPSON và nhiều thương hiệu uy tín khác.</p>

            <h3 class="page-section-title">Thông tin liên hệ</h3>
            <div class="info-grid">
              <div class="info-item">
                <span class="info-label">Địa chỉ:</span>
                <span class="info-value">Ngõ 51 Lương Khánh Thiện - Hoàng Mai - Hà Nội</span>
              </div>
              <div class="info-item">
                <span class="info-label">Điện thoại:</span>
                <span class="info-value"><a href={`tel:${site.sales.tel}`}>{site.sales.display}</a></span>
              </div>
              <div class="info-item">
                <span class="info-label">Email:</span>
                <span class="info-value"><a href="mailto:info@gxcompany.com">info@gxcompany.com</a></span>
              </div>
              <div class="info-item">
                <span class="info-label">Năm thành lập:</span>
                <span class="info-value">2006</span>
              </div>
            </div>

            <h3 class="page-section-title">Sứ mệnh</h3>
            <p>Chúng tôi cam kết mang đến cho khách hàng những sản phẩm công nghệ chính hãng với giá gốc tốt nhất, dịch vụ hậu mãi tận tâm và giải pháp kỹ thuật chuyên nghiệp. Mục tiêu của chúng tôi là trở thành đối tác công nghệ tin cậy nhất của mọi doanh nghiệp và gia đình Việt Nam.</p>

            <h3 class="page-section-title">Giá trị cốt lõi</h3>
            <div class="values-grid">
              <div class="value-card">
                <div class="value-icon">⚡</div>
                <h4 class="value-title">Nhanh Chóng</h4>
                <p class="value-desc">Xử lý đơn hàng nhanh, giao hàng đúng hẹn, hỗ trợ kỹ thuật kịp thời.</p>
              </div>
              <div class="value-card">
                <div class="value-icon">✅</div>
                <h4 class="value-title">Chất Lượng</h4>
                <p class="value-desc">100% sản phẩm chính hãng, hàng mới nguyên hộp, đảm bảo tiêu chuẩn chất lượng.</p>
              </div>
              <div class="value-card">
                <div class="value-icon">🏆</div>
                <h4 class="value-title">Uy Tín</h4>
                <p class="value-desc">Hơn 18 năm hoạt động, hàng nghìn khách hàng tin tưởng và đồng hành.</p>
              </div>
              <div class="value-card">
                <div class="value-icon">💰</div>
                <h4 class="value-title">Giá Gốc</h4>
                <p class="value-desc">Cam kết giá nhập từ nhà sản xuất, không qua trung gian, tiết kiệm tối đa chi phí.</p>
              </div>
            </div>
          </div>
        </div>

        <aside class="page-sidebar">
          <SalesConsultant />
          <ContactSupport />
        </aside>

      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .main-content { padding: 16px 0 24px; }

  .breadcrumb { font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 16px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .breadcrumb a { color: var(--color-primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { color: var(--color-primary); font-weight: 500; }

  .page-layout { display: flex; gap: 16px; align-items: flex-start; }
  .page-main { flex: 1; min-width: 0; }
  .page-sidebar { flex-shrink: 0; width: 240px; display: flex; flex-direction: column; gap: 14px; position: sticky; top: 50px; }

  .page-card { background: white; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 28px; }
  .page-title { font-size: 1.4rem; font-weight: 700; color: var(--color-text); border-left: 4px solid var(--color-red); padding-left: 12px; margin-bottom: 20px; }
  .page-section-title { font-size: 1rem; font-weight: 700; color: var(--color-primary); margin: 20px 0 8px; }
  p { font-size: 0.88rem; line-height: 1.7; color: var(--color-text-light); margin-bottom: 10px; }

  /* Company header */
  .company-header { background: #f8fafd; border: 1px solid #e0ecf8; border-radius: var(--radius-md); padding: 20px; margin-bottom: 20px; }
  .company-logo-area { display: flex; align-items: center; gap: 16px; }
  .company-logo-box { flex-shrink: 0; width: 72px; height: 72px; border-radius: 50%; overflow: hidden; }
  .company-logo-box img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .company-name { font-size: 1.1rem; font-weight: 700; color: var(--color-text); margin-bottom: 4px; }
  .company-tagline { font-size: 0.82rem; color: var(--color-primary); font-weight: 500; }

  /* Info grid */
  .info-grid { display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }
  .info-item { display: flex; gap: 8px; font-size: 0.88rem; }
  .info-label { color: var(--color-text-light); font-weight: 600; min-width: 120px; flex-shrink: 0; }
  .info-value { color: var(--color-text); }
  .info-value a { color: var(--color-primary); }

  /* Values grid */
  .values-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 8px; }
  .value-card { background: #f8fafd; border: 1px solid #e0ecf8; border-radius: var(--radius-md); padding: 16px; }
  .value-icon { font-size: 1.6rem; margin-bottom: 8px; }
  .value-title { font-size: 0.92rem; font-weight: 700; color: var(--color-text); margin-bottom: 6px; }
  .value-desc { font-size: 0.8rem; color: var(--color-text-light); line-height: 1.5; margin-bottom: 0; }

  /* Contact widget styles live in ContactSupport.astro */

  @media (max-width: 768px) {
    .page-layout { flex-direction: column; }
    .page-sidebar { width: 100%; position: static; }
    .values-grid { grid-template-columns: 1fr; }
  }
</style>
