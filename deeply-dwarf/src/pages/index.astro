---

<Layout title="Siêu Thị Viễn Thông - Camera, Mạng, Access Control - Giá Gốc">
  <TopBar />
  <Header />
  <NavBar />

  <main class="main-content">
    <div class="container">
      <HeroSection />

      <!-- Main 2-column layout: content + sidebar -->
      <div class="page-layout">
        <div class="page-layout__content">
          <ProductSection
            id="san-pham-ban-chay"
            title="Sản phẩm bán chạy"
            products={bestsellerProducts}
            showViewMore={true}
            viewMoreUrl="/san-pham-ban-chay"
          />

          <ProductSection
            id="san-pham-moi"
            title="Sản phẩm mới"
            products={newProducts}
            showViewMore={true}
            viewMoreUrl="/san-pham-moi"
          />

          <ProductSection
            id="khuyen-mai"
            title="🔥 Sản phẩm khuyến mãi"
            products={saleProducts}
            showViewMore={true}
            viewMoreUrl="/khuyen-mai"
          />
        </div>

        <!-- Sidebar -->
        <aside class="page-layout__sidebar">
          <SalesConsultant />

          <!-- Quick links widget -->
          <div class="quick-links-widget">
            <div class="quick-links-widget__header">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z"/>
              </svg>
              DANH MỤC SẢN PHẨM
            </div>
            <ul class="quick-links-list">
              <li><a href="#" class="quick-link">Camera Quan Sát</a></li>
              <li><a href="#" class="quick-link">Mạng Máy Tính</a></li>
              <li><a href="#" class="quick-link">Thiết Bị Viễn Thông</a></li>
              <li><a href="#" class="quick-link">Access Control</a></li>
              <li><a href="#" class="quick-link">Thiết Bị Báo Động</a></li>
              <li><a href="#" class="quick-link">Thiết Bị Âm Thanh</a></li>
              <li><a href="#" class="quick-link">Thiết Bị Văn Phòng</a></li>
              <li><a href="#" class="quick-link">Thiết Bị Bán Hàng</a></li>
              <li><a href="#" class="quick-link">Smart Devices</a></li>
              <li><a href="#" class="quick-link">Vật tư &amp; Thiết bị Điện</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .main-content {
    padding: 16px 0 0;
  }

  /* Page layout: content + sidebar */
  .page-layout {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .page-layout__content {
    flex: 1;
    min-width: 0;
  }

  .page-layout__sidebar {
    flex-shrink: 0;
    width: 240px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: sticky;
    top: 50px;
  }

  /* Quick links widget */
  .quick-links-widget {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .quick-links-widget__header {
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .quick-links-list {
    padding: 4px 0;
  }

  .quick-links-list li {
    border-bottom: 1px solid #f0f0f0;
  }

  .quick-links-list li:last-child {
    border-bottom: none;
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    font-size: 0.8rem;
    color: var(--color-text);
    text-decoration: none;
    transition: all 0.15s;
  }

  .quick-link::before {
    content: '›';
    color: var(--color-primary);
    font-weight: 700;
    font-size: 1rem;
  }

  .quick-link:hover {
    background: #f0f6ff;
    color: var(--color-primary);
    padding-left: 18px;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .page-layout {
      flex-direction: column;
    }
    .page-layout__sidebar {
      width: 100%;
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .page-layout__sidebar > * {
      flex: 1;
      min-width: 220px;
    }
  }

  @media (max-width: 600px) {
    .page-layout__sidebar {
      flex-direction: column;
    }
  }
</style>
