---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import NavBar from '../../components/NavBar.astro';
import SalesConsultant from '../../components/SalesConsultant.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';

// CONTENTFUL-READY: Replace this with Contentful API fetch when integrating
type CategoryData = {
  label: string;
  description: string;
  subcategories: string[];
  products: Array<{
    slug: string;
    name: string;
    code: string;
    price: string;
    originalPrice?: string;
    discount?: number;
    image: string;
  }>;
};

export function getStaticPaths() {
  const CATEGORIES: Record<string, CategoryData> = {
    'camera-quan-sat': {
      label: 'Camera Quan Sát',
      description: 'Cung cấp các loại camera nổi tiếng, chất lượng cao, giúp bảo vệ an ninh cho gia đình và doanh nghiệp một cách hiệu quả, tin cậy.',
      subcategories: ['Camera IP', 'Camera Analog', 'Đầu Ghi Camera', 'Các Phụ Kiện Camera', 'Camera hành trình'],
      products: [
        { slug: 'camera-ip-8mp-hikvision-ds-2cd2083g2-iu', name: 'Camera IP 8MP HIKVISION DS-2CD2083G2-IU', code: '55871234', price: '2.850.000 ₫', image: 'https://placehold.co/200x160?text=Camera+8MP' },
        { slug: 'camera-ip-2mp-hikvision-ds-2cd1027g2h-liu', name: 'Camera IP 2MP HIKVISION DS-2CD1027G2H-LIU', code: '34959069', price: '1.485.000 ₫', originalPrice: '1.860.000 ₫', discount: 20, image: 'https://placehold.co/200x160?text=DS-2CD1027G2H' },
        { slug: 'camera-ip-4mp-hikvision-ds-2cd1047g2h-liu', name: 'Camera IP 4MP HIKVISION DS-2CD1047G2H-LIU', code: '14541018', price: '1.600.000 ₫', originalPrice: '2.000.000 ₫', discount: 20, image: 'https://placehold.co/200x160?text=DS-2CD1047G2H' },
        { slug: 'camera-ip-4mp-hikvision-ds-2cd1t47g2h-liu', name: 'Camera IP 4MP HIKVISION DS-2CD1T47G2H-LIU', code: '08533247', price: '1.730.000 ₫', originalPrice: '2.350.000 ₫', discount: 20, image: 'https://placehold.co/200x160?text=DS-2CD1T47G2H' },
        { slug: 'camera-ip-2mp-hikvision-ds-2cd1327g2h-liu', name: 'Camera IP 2MP HIKVISION DS-2CD1327G2H-LIU', code: '71469016', price: '1.580.000 ₫', originalPrice: '1.975.000 ₫', discount: 20, image: 'https://placehold.co/200x160?text=DS-2CD1327G2H' },
        { slug: 'dau-ghi-hinh-ip-8-kenh-hikvision-ds-7608nxi-i2', name: 'Đầu ghi hình IP 8 kênh HIKVISION DS-7608NXI-I2', code: '23478901', price: '4.100.000 ₫', image: 'https://placehold.co/200x160?text=NVR+8CH' },
      ],
    },
    'mang-may-tinh': {
      label: 'Mạng Máy Tính',
      description: 'Thiết bị mạng chính hãng: Switch, Router, WiFi Access Point, cáp mạng và các phụ kiện hạ tầng mạng doanh nghiệp.',
      subcategories: ['Switch', 'Router', 'WiFi Access Point', 'Cáp & Đầu nối', 'Rack & Tủ mạng'],
      products: [
        { slug: '4-port-ge-poe-switch-ruijie-rg-es207gs-p', name: '4-Port GE PoE Switch RUIJIE RG-ES207GS-P', code: '03387812', price: '1.400.000 ₫', image: 'https://placehold.co/200x160?text=RG-ES207GS-P' },
        { slug: '4-port-ge-poe-switch-ruijie-rg-es207gs-lp', name: '4-Port GE PoE Switch RUIJIE RG-ES207GS-LP', code: '72423584', price: '1.250.000 ₫', image: 'https://placehold.co/200x160?text=RG-ES207GS-LP' },
        { slug: '16-port-ge-poe-switch-ruijie-rg-es220gs-p-v2', name: '16-Port GE PoE Switch RUIJIE RG-ES220GS-P-V2', code: '97335756', price: '4.650.000 ₫', originalPrice: '5.810.000 ₫', discount: 20, image: 'https://placehold.co/200x160?text=RG-ES220GS-P' },
        { slug: 'bo-phat-wifi-6-tp-link-eap670-ax3000', name: 'Bộ phát WiFi 6 TP-Link EAP670 AX3000', code: '88342910', price: '3.200.000 ₫', image: 'https://placehold.co/200x160?text=WiFi+EAP670' },
        { slug: 'switch-24-port-gigabit-ruijie-rg-s1924g', name: 'Switch 24-Port Gigabit RUIJIE RG-S1924G', code: '44218763', price: '1.850.000 ₫', image: 'https://placehold.co/200x160?text=Switch+24P' },
      ],
    },
    'thiet-bi-vien-thong': {
      label: 'Thiết Bị Viễn Thông',
      description: 'Nguồn lưu điện UPS, thiết bị viễn thông, tổng đài điện thoại và các giải pháp truyền thông doanh nghiệp.',
      subcategories: ['Nguồn lưu điện UPS', 'Tổng đài IP', 'Điện thoại IP', 'Modem & Gateway'],
      products: [
        { slug: 'nguon-luu-dien-ups-sorotec-bl1200-lcd', name: 'Nguồn lưu điện UPS SOROTEC BL1200 LCD', code: '13738294', price: '2.650.000 ₫', image: 'https://placehold.co/200x160?text=UPS+BL1200' },
        { slug: 'nguon-luu-dien-ups-sorotec-bl1000-lcd', name: 'Nguồn lưu điện UPS SOROTEC BL1000 LCD', code: '61380847', price: '2.580.000 ₫', image: 'https://placehold.co/200x160?text=UPS+BL1000' },
      ],
    },
    'access-control': {
      label: 'Access Control',
      description: 'Hệ thống kiểm soát ra vào, máy chấm công, khóa điện từ và các giải pháp bảo mật vật lý cho doanh nghiệp.',
      subcategories: ['Máy chấm công', 'Khóa điện từ', 'Đầu đọc thẻ', 'Barrier & Cổng tự động'],
      products: [
        { slug: 'may-cham-cong-van-tay-hikvision-ds-k1t804bmf', name: 'Máy chấm công vân tay HIKVISION DS-K1T804BMF', code: '67932148', price: '3.600.000 ₫', image: 'https://placehold.co/200x160?text=Access+Ctrl' },
      ],
    },
    'thiet-bi-bao-dong': {
      label: 'Thiết Bị Báo Động',
      description: 'Hệ thống báo trộm, báo cháy, cảm biến và trung tâm báo động chính hãng.',
      subcategories: ['Trung tâm báo động', 'Cảm biến', 'Còi hú', 'Báo cháy'],
      products: [],
    },
    'thiet-bi-am-thanh': {
      label: 'Thiết Bị Âm Thanh',
      description: 'Loa, amply, micro và hệ thống âm thanh hội trường, phòng họp chuyên nghiệp.',
      subcategories: ['Loa', 'Amply', 'Micro', 'Mixer'],
      products: [],
    },
    'thiet-bi-van-phong': {
      label: 'Thiết Bị Văn Phòng',
      description: 'Máy in, máy chiếu, máy scan và các thiết bị văn phòng chính hãng.',
      subcategories: ['Máy in', 'Máy chiếu', 'Máy scan', 'Mực in'],
      products: [
        { slug: 'may-chieu-epson-eb-x52', name: 'Máy chiếu EPSON EB-X52', code: '14833700', price: '15.500.000 ₫', originalPrice: '19.375.000 ₫', discount: 20, image: 'https://placehold.co/200x160?text=EPSON+EB-X52' },
      ],
    },
    'thiet-bi-ban-hang': {
      label: 'Thiết Bị Bán Hàng',
      description: 'Máy tính tiền, máy quét mã vạch, máy in hóa đơn và thiết bị POS.',
      subcategories: ['Máy tính tiền', 'Máy quét mã vạch', 'Máy in hóa đơn', 'Màn hình cảm ứng'],
      products: [],
    },
    'may-dinh-vi-do': {
      label: 'Máy Định Vị & Đo',
      description: 'Thiết bị định vị GPS, máy đo khoảng cách laser và các dụng cụ đo lường chuyên dụng.',
      subcategories: ['Định vị GPS', 'Máy đo khoảng cách', 'Máy đo nhiệt độ'],
      products: [],
    },
    'smart-devices': {
      label: 'Smart Devices',
      description: 'Thiết bị nhà thông minh, khóa thông minh, chuông cửa video và các giải pháp IoT.',
      subcategories: ['Khóa thông minh', 'Chuông cửa', 'Công tắc thông minh', 'Cảm biến IoT'],
      products: [],
    },
    'vat-tu-thiet-bi-dien': {
      label: 'Vật Tư & Thiết Bị Điện',
      description: 'Dây cáp điện, ổ cắm, CB, cầu dao và vật tư điện các loại.',
      subcategories: ['Dây & Cáp điện', 'CB & Cầu dao', 'Ổ cắm & Công tắc', 'Đèn LED'],
      products: [],
    },
  };

  return Object.entries(CATEGORIES).map(([cat, data]) => ({
    params: { category: cat },
    props: { categoryData: data },
  }));
}

interface Props {
  categoryData: CategoryData;
}

const { category } = Astro.params;
const { categoryData } = Astro.props;
---

<Layout title={categoryData.label + ' - Siêu Thị Viễn Thông'}>
  <TopBar />
  <Header />
  <NavBar />

  <main class="main-content">
    <div class="container">

      <nav class="breadcrumb">
        <a href="/">🏠 Trang chủ</a> ›
        <a href={`/danh-muc/${category}`}>{categoryData.label}</a>
      </nav>

      <div class="category-layout">

        <!-- Sidebar -->
        <aside class="category-sidebar">
          <div class="cat-widget">
            <div class="cat-widget__header">{categoryData.label}</div>
            <ul class="cat-widget__list">
              {categoryData.subcategories.map(sub => (
                <li>
                  <a href="#" class="cat-widget__link">{sub}</a>
                </li>
              ))}
            </ul>
          </div>

          <SalesConsultant />
        </aside>

        <!-- Main content -->
        <div class="category-main">

          <!-- Category banner -->
          <div class="category-banner">
            <div class="category-banner__text">
              <h1 class="category-title">{categoryData.label}</h1>
              <p class="category-desc">{categoryData.description}</p>
            </div>
            <div class="category-banner__image" aria-hidden="true">
              <svg viewBox="0 0 80 80" width="80" height="80" fill="none" opacity="0.4">
                <rect width="80" height="80" rx="12" fill="#1a6fb3"/>
                <path d="M20 56V32l20-12 20 12v24H20z" stroke="white" stroke-width="2" fill="none"/>
                <circle cx="40" cy="36" r="6" stroke="white" stroke-width="2" fill="none"/>
                <path d="M32 56v-6a8 8 0 0116 0v6" stroke="white" stroke-width="2" fill="none"/>
              </svg>
            </div>
          </div>

          <!-- Filter / sort bar -->
          <div class="filter-bar">
            <span class="filter-bar__label">Sắp xếp theo:</span>
            <div class="filter-bar__tabs">
              <button class="filter-tab filter-tab--active">Mới nhất</button>
              <button class="filter-tab">Bán chạy</button>
              <button class="filter-tab">Giá thấp</button>
              <button class="filter-tab">Giá cao</button>
            </div>
          </div>

          <!-- Products or empty state -->
          {categoryData.products.length > 0 ? (
            <div class="category-products">
              <div class="product-grid product-grid--4col">
                {categoryData.products.map(p => (
                  <ProductCard
                    slug={p.slug}
                    name={p.name}
                    code={p.code}
                    price={p.price}
                    originalPrice={p.originalPrice}
                    discount={p.discount}
                    image={p.image}
                  />
                ))}
              </div>
            </div>
          ) : (
            <div class="empty-category">
              <svg viewBox="0 0 64 64" width="64" height="64" fill="currentColor">
                <path d="M32 4C16.536 4 4 16.536 4 32s12.536 28 28 28 28-12.536 28-28S47.464 4 32 4zm0 4c13.255 0 24 10.745 24 24S45.255 56 32 56 8 45.255 8 32 18.745 8 32 8zm-2 10v16h4V18h-4zm0 20v4h4v-4h-4z"/>
              </svg>
              <p>Đang cập nhật sản phẩm...</p>
              <small>Vui lòng quay lại sau hoặc liên hệ (028) 7300 1535 để được tư vấn.</small>
            </div>
          )}

        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .main-content { padding: 12px 0 0; }

  .breadcrumb { font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 14px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .breadcrumb a { color: var(--color-primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  /* Layout */
  .category-layout { display: flex; gap: 16px; align-items: flex-start; }
  .category-sidebar { flex-shrink: 0; width: 220px; display: flex; flex-direction: column; gap: 14px; position: sticky; top: 50px; }
  .category-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 14px; }

  /* Category widget in sidebar */
  .cat-widget { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
  .cat-widget__header { background: var(--color-primary); color: white; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; padding: 10px 14px; letter-spacing: 0.04em; }
  .cat-widget__list { padding: 4px 0; }
  .cat-widget__link { display: flex; align-items: center; gap: 6px; padding: 8px 14px; font-size: 0.8rem; color: var(--color-text); text-decoration: none; border-bottom: 1px solid #f0f0f0; transition: all 0.15s; }
  .cat-widget__link::before { content: '›'; color: var(--color-primary); font-weight: 700; font-size: 1rem; }
  .cat-widget__link:hover { background: #f0f6ff; color: var(--color-primary); padding-left: 18px; }

  /* Category banner */
  .category-banner { background: linear-gradient(135deg, #e8f4ff 0%, #d0e8f8 100%); border: 1px solid #c0daf0; border-radius: var(--radius-md); padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; }
  .category-title { font-size: 1.3rem; font-weight: 700; color: var(--color-text); margin-bottom: 8px; }
  .category-desc { font-size: 0.85rem; color: var(--color-text-light); line-height: 1.6; max-width: 500px; }

  /* Filter bar */
  .filter-bar { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 10px 16px; display: flex; align-items: center; gap: 12px; }
  .filter-bar__label { font-size: 0.82rem; color: var(--color-text-light); font-weight: 500; white-space: nowrap; }
  .filter-bar__tabs { display: flex; gap: 4px; }
  .filter-tab { padding: 5px 14px; font-size: 0.8rem; font-weight: 500; background: none; border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-text-light); cursor: pointer; transition: all 0.15s; font-family: inherit; }
  .filter-tab:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .filter-tab--active { background: var(--color-primary); border-color: var(--color-primary); color: white; }

  /* Product grid override for 4-col */
  .product-grid--4col { grid-template-columns: repeat(4, 1fr); }

  /* Product grid card wrapper */
  .category-products { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 16px; }

  /* Empty state */
  .empty-category { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 60px 20px; text-align: center; color: var(--color-text-muted); }
  .empty-category svg { margin: 0 auto 16px; opacity: 0.3; }
  .empty-category p { font-size: 1rem; font-weight: 500; }
  .empty-category small { font-size: 0.82rem; }

  @media (max-width: 900px) {
    .category-layout { flex-direction: column; }
    .category-sidebar { width: 100%; position: static; }
    .product-grid--4col { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .product-grid--4col { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
document.querySelectorAll('.filter-tab').forEach(tab => {
  tab.addEventListener('click', function(this: HTMLButtonElement) {
    document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('filter-tab--active'));
    this.classList.add('filter-tab--active');
  });
});
</script>
