---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import NavBar from '../../components/NavBar.astro';
import SalesConsultant from '../../components/SalesConsultant.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCategoriesWithProducts } from '../../lib/contentful/queries';
import type { CategoryPageData } from '../../lib/contentful/types';
import ProductSection from '../../components/ProductSection.astro';

export async function getStaticPaths() {
  const categories = await getCategoriesWithProducts();

  return categories.map((categoryData) => ({
    params: { category: categoryData.slug },
    props: { categoryData },
  }));
}

interface Props {
  categoryData: CategoryPageData;
}

const { category } = Astro.params;
const { categoryData } = Astro.props;
---

<Layout title={categoryData.label + ' - Gx công nghệ'}>
  <TopBar />
  <Header />
  <NavBar />

  <main class="main-content">
    <div class="container">

      <nav class="breadcrumb">
        <a href="/">🏠 Trang chủ</a> ›
        <a href={`/danh-muc/${category}`}>{categoryData.label}</a>
      </nav>

      <div class="category-layout">

        <!-- Sidebar -->
        <aside class="category-sidebar">
          <div class="cat-widget">
            <div class="cat-widget__header">{categoryData.label}</div>
            <ul class="cat-widget__list">
              {categoryData.subcategories.map(sub => (
                <li>
                  <a href="#" class="cat-widget__link">{sub}</a>
                </li>
              ))}
            </ul>
          </div>

          <SalesConsultant />
        </aside>

        <!-- Main content -->
        <div class="category-main">

          <!-- Category banner -->
          <div class="category-banner">
            <div class="category-banner__text">
              <h1 class="category-title">{categoryData.label}</h1>
              <p class="category-desc">{categoryData.description}</p>
            </div>
            <div class="category-banner__image" aria-hidden="true">
              <svg viewBox="0 0 80 80" width="80" height="80" fill="none" opacity="0.4">
                <rect width="80" height="80" rx="12" fill="#1a6fb3"/>
                <path d="M20 56V32l20-12 20 12v24H20z" stroke="white" stroke-width="2" fill="none"/>
                <circle cx="40" cy="36" r="6" stroke="white" stroke-width="2" fill="none"/>
                <path d="M32 56v-6a8 8 0 0116 0v6" stroke="white" stroke-width="2" fill="none"/>
              </svg>
            </div>
          </div>

          <!-- Filter / sort bar -->
          <div class="filter-bar">
            <span class="filter-bar__label">Sắp xếp theo:</span>
            <div class="filter-bar__tabs">
              <button class="filter-tab filter-tab--active">Mới nhất</button>
              <button class="filter-tab">Bán chạy</button>
              <button class="filter-tab">Giá thấp</button>
              <button class="filter-tab">Giá cao</button>
            </div>
          </div>

          <!-- Products or empty state -->
          {categoryData.products.length > 0 ? (
            <ProductSection
              title={categoryData.label}
              products={categoryData.products}
              allProducts={categoryData.products}
              showViewMore={true}
              viewMoreUrl="#"
            />
          ) : (
            <div class="empty-category">
              <svg viewBox="0 0 64 64" width="64" height="64" fill="currentColor">
                <path d="M32 4C16.536 4 4 16.536 4 32s12.536 28 28 28 28-12.536 28-28S47.464 4 32 4zm0 4c13.255 0 24 10.745 24 24S45.255 56 32 56 8 45.255 8 32 18.745 8 32 8zm-2 10v16h4V18h-4zm0 20v4h4v-4h-4z"/>
              </svg>
              <p>Đang cập nhật sản phẩm...</p>
              <small>Vui lòng quay lại sau hoặc liên hệ (028) 7300 1535 để được tư vấn.</small>
            </div>
          )}

        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .main-content { padding: 12px 0 0; }

  .breadcrumb { font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 14px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .breadcrumb a { color: var(--color-primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  /* Layout */
  .category-layout { display: flex; gap: 16px; align-items: flex-start; }
  .category-sidebar { flex-shrink: 0; width: 220px; display: flex; flex-direction: column; gap: 14px; position: sticky; top: 50px; }
  .category-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 14px; }

  /* Category widget in sidebar */
  .cat-widget { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
  .cat-widget__header { background: var(--color-primary); color: white; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; padding: 10px 14px; letter-spacing: 0.04em; }
  .cat-widget__list { padding: 4px 0; }
  .cat-widget__link { display: flex; align-items: center; gap: 6px; padding: 8px 14px; font-size: 0.8rem; color: var(--color-text); text-decoration: none; border-bottom: 1px solid #f0f0f0; transition: all 0.15s; }
  .cat-widget__link::before { content: '›'; color: var(--color-primary); font-weight: 700; font-size: 1rem; }
  .cat-widget__link:hover { background: #f0f6ff; color: var(--color-primary); padding-left: 18px; }

  /* Category banner */
  .category-banner { background: linear-gradient(135deg, #e8f4ff 0%, #d0e8f8 100%); border: 1px solid #c0daf0; border-radius: var(--radius-md); padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; }
  .category-title { font-size: 1.3rem; font-weight: 700; color: var(--color-text); margin-bottom: 8px; }
  .category-desc { font-size: 0.85rem; color: var(--color-text-light); line-height: 1.6; max-width: 500px; }

  /* Filter bar */
  .filter-bar { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 10px 16px; display: flex; align-items: center; gap: 12px; }
  .filter-bar__label { font-size: 0.82rem; color: var(--color-text-light); font-weight: 500; white-space: nowrap; }
  .filter-bar__tabs { display: flex; gap: 4px; }
  .filter-tab { padding: 5px 14px; font-size: 0.8rem; font-weight: 500; background: none; border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-text-light); cursor: pointer; transition: all 0.15s; font-family: inherit; }
  .filter-tab:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .filter-tab--active { background: var(--color-primary); border-color: var(--color-primary); color: white; }

  /* Product grid override for 4-col */
  .product-grid--4col { grid-template-columns: repeat(4, 1fr); }

  /* Product grid card wrapper */
  .category-products { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 16px; }

  /* Empty state */
  .empty-category { background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 60px 20px; text-align: center; color: var(--color-text-muted); }
  .empty-category svg { margin: 0 auto 16px; opacity: 0.3; }
  .empty-category p { font-size: 1rem; font-weight: 500; }
  .empty-category small { font-size: 0.82rem; }

  @media (max-width: 900px) {
    .category-layout { flex-direction: column; }
    .category-sidebar { width: 100%; position: static; }
    .product-grid--4col { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .product-grid--4col { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
document.querySelectorAll('.filter-tab').forEach(tab => {
  tab.addEventListener('click', function(this: HTMLButtonElement) {
    document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('filter-tab--active'));
    this.classList.add('filter-tab--active');
  });
});
</script>
